# Used only when no administrator account has been initialized yet.
TDL_ADMIN_USERNAME=admin
TDL_ADMIN_INITIAL_PASSWORD=change-this-before-first-start

# Container paths. Keep these on persistent volumes in production.
TDL_DATA_DIR=/data
TDL_DOWNLOAD_DIR=/downloads
TDL_LISTEN_ADDR=:8080

# Production HTTPS reverse proxy only. Keep false for the local Compose setup
# because it is intentionally served as http://127.0.0.1:8080.
TDL_COOKIE_SECURE=false
# Comma-separated browser origins allowed to send state-changing requests.
# Example: https://tdl.example.com
TDL_TRUSTED_ORIGINS=
